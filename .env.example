# Auth.js / NextAuth — local/demo only. Production needs a real IdP.
AUTH_SECRET=replace-with-long-random-string
AUTH_TRUST_HOST=true

# Demo credentials (not production-safe)
ADMIN_EMAIL=admin@kietauto.local
ADMIN_PASSWORD=admin-demo
EDITOR_EMAIL=editor@kietauto.local
EDITOR_PASSWORD=editor-demo

# AI: leave unset or "mock". Setting "openai" still will not call the network until enabled.
AI_PROVIDER=mock
# OPENAI_API_KEY=  # optional later — never required for current MVP

# --- Quote request submission (required for “Yêu cầu báo giá” to succeed) ---
# Without these, POST /api/quote/request returns 503 and the UI shows a clear error
# (never fake success). PII is forwarded only when the customer consents.
QUOTE_WEBHOOK_URL=
# Optional bearer secret sent as Authorization: Bearer …
QUOTE_WEBHOOK_SECRET=
