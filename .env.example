# Auth.js / NextAuth — Phase 1 local demo only. Production needs a real IdP.
AUTH_SECRET=replace-with-long-random-string
AUTH_TRUST_HOST=true

# Demo credentials (not production-safe)
ADMIN_EMAIL=admin@kietauto.local
ADMIN_PASSWORD=admin-demo
EDITOR_EMAIL=editor@kietauto.local
EDITOR_PASSWORD=editor-demo

# AI: leave unset or "mock". Setting "openai" still will not call the network in Phase 1.
AI_PROVIDER=mock
# OPENAI_API_KEY=  # optional later — never required for Phase 1
